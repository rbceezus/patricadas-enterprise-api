# EMPREST.AI API — variáveis de ambiente (exemplo, SEM segredos)
# Copie para .env e preencha com valores reais. NUNCA commite o .env.

# --- Ambiente ---
NODE_ENV=development
PORT=3000

# --- Banco (Supabase / PostgreSQL) ---
# Runtime: pooler de transação (Supavisor), porta 6543, com pgbouncer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations: conexão direta, porta 5432
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-anon-publica
# service_role: SOMENTE nesta API, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=chave-service-role
# Validação de JWT pelo JWKS do Supabase
SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json

# --- CORS ---
# Origem do frontend permitida (allowlist)
FRONTEND_ORIGIN=http://localhost:5173

# --- Observabilidade ---
SENTRY_DSN=
